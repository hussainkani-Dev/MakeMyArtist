{
  "expo": {
    "name": "MakeMyArtist",
    "slug": "MakeMyArtist",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/Splash_Imgae_final.jpeg",
    "scheme": "makemyartist",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.MakeMyArtist"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/Splash_Imgae_final.jpeg",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/Splash_Imgae_final.jpeg",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "74ace5d5-d1c3-4990-8966-7ae977277d1f"
      }
    },
    "owner": "devuser"
  }
}
